{
  "schemaVersion": 1,
  "stylesheet": {
    "path": "src/styles/global.css",
    "requiredTokens": ["--space-1", "--space-2", "--space-3", "--space-4", "--space-5", "--space-6", "--space-7", "--space-8", "--flow-paragraph", "--flow-block", "--flow-heading", "--cover-aspect"],
    "requiredRules": [".prose :where(h2)", ".prose :where(li + li)", ".prose > :first-child", ".prose :where(pre:not(.mermaid), table, figure)"]
  },
  "diagrams": {
    "maxNodes": 8,
    "maxLabelLineLength": 24,
    "maxHorizontalChain": 3,
    "maxSequenceParticipants": 4,
    "visual": {
      "minRenderedTextPx": 14,
      "minContrastRatio": 4.5,
      "maxScaleDownRatio": 0.9,
      "themes": ["light", "dark"]
    },
    "optIn": { "frontMatterKey": "authoringVersion", "value": 1 }
  },
  "covers": {
    "directory": "public/post-covers",
    "viewBox": "0 0 1200 630",
    "minSafeMarginPercent": 10,
    "cssSelector": ".post-cover",
    "requiredCssDeclarations": ["object-fit: contain", "aspect-ratio: var(--cover-aspect)"],
    "aspectToken": { "name": "--cover-aspect", "value": "1200 / 630" },
    "surfaces": [
      { "selector": ".post-card-cover", "requiredCssDeclarations": ["object-fit: contain", "max-block-size: 12rem"] }
    ],
    "forbiddenCssDeclarations": ["object-fit: cover", "object-fit: fill"],
    "raster": { "minAspect": 1.4, "maxAspect": 2.4, "baseline": "scripts/blog-cover-baseline.json" }
  }
}
