---
const deploymentId = import.meta.env.GITHUB_SHA ?? new Date().toISOString();
---

<header class="site-header" data-deployment-id={deploymentId}>
  <div class="header-inner">
    <a href="/" class="brand-title">Yegun Kim Tech Blog</a>
    <nav class="header-nav" aria-label="Primary Navigation">
      <a href="/">Posts</a>
      <a href="https://github.com/ibocon" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/rss.xml">RSS</a>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        aria-pressed="false"
      >
        <svg class="theme-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.42 1.42M7.05 16.95l-1.42 1.42m0-12.72 1.42 1.42m9.9 9.9 1.42 1.42" />
          <circle cx="12" cy="12" r="4" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const deploymentId = document.querySelector('.site-header')?.dataset.deploymentId;
    const root = document.documentElement;
    const button = document.getElementById('theme-toggle');
    const saved = localStorage.getItem('theme');
    const applyTheme = (theme, persist = false) => {
      root.dataset.theme = theme;
      button?.setAttribute('aria-pressed', String(theme === 'dark'));
      button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);

      if (persist) {
        localStorage.setItem('theme', theme);
      }
    };

    applyTheme(saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
    button?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      applyTheme(next, true);
    });

    const checkForDeploymentUpdate = async () => {
      if (document.visibilityState !== 'visible' || !deploymentId) {
        return;
      }

      try {
        const response = await fetch(window.location.href, { cache: 'no-store' });
        const html = await response.text();
        const nextDeploymentId = html.match(/data-deployment-id="([^"]+)"/)?.[1];
        if (nextDeploymentId && nextDeploymentId !== deploymentId) {
          window.location.reload();
        }
      } catch {
        // A transient update check failure must not interrupt the current page.
      }
    };

    window.setInterval(() => {
      void checkForDeploymentUpdate();
    }, 60_000);
  })();
</script>
