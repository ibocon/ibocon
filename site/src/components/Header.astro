<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-title">Yegun Kim Tech Blog</a>
    <nav class="header-nav" aria-label="Primary Navigation">
      <a href="/">Posts</a>
      <a href="https://github.com/ibocon" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/rss.xml">RSS</a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">Theme</button>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const saved = localStorage.getItem('theme');
    root.dataset.theme = saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  })();
</script>
