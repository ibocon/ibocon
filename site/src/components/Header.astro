---
import { alternatePath, localeNames, locales, type Locale, type LocalizedPage } from '../lib/locale';
import { siteCopy } from '../lib/site-copy';

interface Props { locale?: Locale; page?: LocalizedPage; }
const { locale = 'ko', page = 'home' } = Astro.props;
const copy = siteCopy[locale];
const localeOptions = locales.map((target) => ({
  locale: target,
  name: localeNames[target],
  href: alternatePath(target, page),
  current: target === locale,
}));

const deploymentId = [
  import.meta.env.GITHUB_SHA,
  import.meta.env.GITHUB_RUN_ID,
].filter(Boolean).join('-') || new Date().toISOString();
---

<header class="site-header" data-deployment-id={deploymentId} data-theme-dark-label={copy.themeDarkLabel} data-theme-light-label={copy.themeLightLabel}>
  <div class="header-inner">
    <a href={alternatePath(locale, 'home')} class="brand-title">{copy.brandName}</a>
    <nav class="header-nav" aria-label={copy.primaryNavigationLabel}>
      <div class="header-nav-primary">
        <a href={alternatePath(locale, 'home')}>{copy.homeLabel}</a>
        <a href={alternatePath(locale, 'about')}>{copy.aboutLabel}</a>
        <a href={alternatePath(locale, 'resume')}>{copy.resumeLabel}</a>
        <a href={alternatePath(locale, 'editorial')}>{copy.editorialLabel}</a>
      </div>
      <div class="header-nav-utility">
        <a class="icon-button" href="https://github.com/ibocon" target="_blank" rel="noopener noreferrer" aria-label={copy.githubLabel} title={copy.githubLabel}>
          <svg class="icon-button-glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.28 2.75 1.05A9.4 9.4 0 0 1 12 6.84c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.81c0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
          </svg>
        </a>
        <a class="icon-button" href="/rss.xml" aria-label={copy.rssLabel} title={copy.rssLabel}>
          <svg class="icon-button-glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M5 11a8 8 0 0 1 8 8M5 4a15 15 0 0 1 15 15" />
            <circle cx="6" cy="18" r="1.5" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
      <details class="locale-menu" data-locale-menu>
        <summary class="locale-menu-trigger" aria-label={`${copy.localeMenuLabel}: ${localeNames[locale]}`}>
          <svg class="locale-menu-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
          </svg>
          <span>{localeNames[locale]}</span>
          <svg class="locale-menu-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ul class="locale-menu-list">
          {localeOptions.map((option) => (
            <li>
              <a href={option.href} lang={option.locale} aria-current={option.current ? 'true' : undefined}>
                {option.name}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label={copy.themeDarkLabel}
        aria-pressed="false"
      >
        <svg class="theme-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.42 1.42M7.05 16.95l-1.42 1.42m0-12.72 1.42 1.42m9.9 9.9 1.42 1.42" />
          <circle cx="12" cy="12" r="4" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const localeMenu = document.querySelector('[data-locale-menu]');
    const localeTrigger = localeMenu?.querySelector('summary');
    if (localeMenu && localeTrigger) {
      const closeLocaleMenu = (restoreFocus) => {
        localeMenu.open = false;
        if (restoreFocus) {
          localeTrigger.focus();
        }
      };

      document.addEventListener('pointerdown', (event) => {
        if (localeMenu.open && !localeMenu.contains(event.target)) {
          closeLocaleMenu(false);
        }
      });
      localeMenu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && localeMenu.open) {
          event.preventDefault();
          closeLocaleMenu(true);
        }
      });
      localeMenu.addEventListener('focusout', (event) => {
        if (localeMenu.open && event.relatedTarget && !localeMenu.contains(event.relatedTarget)) {
          closeLocaleMenu(false);
        }
      });
    }

    const deploymentId = document.querySelector('.site-header')?.dataset.deploymentId;
    const root = document.documentElement;
    const darkLabel = document.querySelector('.site-header')?.dataset.themeDarkLabel ?? 'Switch to dark theme';
    const lightLabel = document.querySelector('.site-header')?.dataset.themeLightLabel ?? 'Switch to light theme';
    const button = document.getElementById('theme-toggle');
    const saved = localStorage.getItem('theme');
    const applyTheme = (theme, persist = false) => {
      root.dataset.theme = theme;
      button?.setAttribute('aria-pressed', String(theme === 'dark'));
      button?.setAttribute('aria-label', theme === 'dark' ? lightLabel : darkLabel);

      if (persist) {
        localStorage.setItem('theme', theme);
      }
    };

    applyTheme(saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));
    button?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      applyTheme(next, true);
    });

    const checkForDeploymentUpdate = async () => {
      if (document.visibilityState !== 'visible' || !deploymentId) {
        return;
      }

      try {
        const response = await fetch(window.location.href, { cache: 'no-store' });
        const html = await response.text();
        const nextDeploymentId = html.match(/data-deployment-id="([^"]+)"/)?.[1];
        if (nextDeploymentId && nextDeploymentId !== deploymentId) {
          window.location.reload();
        }
      } catch {
        // A transient update check failure must not interrupt the current page.
      }
    };

    window.setInterval(() => {
      void checkForDeploymentUpdate();
    }, 60_000);
  })();
</script>
