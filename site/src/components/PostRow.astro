---
import { getPostPresentation } from '../lib/post-presentation';

const { post } = Astro.props;
const presentation = getPostPresentation(post.data, post.body ?? '');
---

<a class="post-row" href={`/${post.id}/`}>
  <div class="post-meta"><span class="badge">{post.data.tags[0]}</span><time datetime={post.data.pubDate.toISOString()}>
    {post.data.pubDate.toISOString().slice(0, 10)}
  </time><span>{presentation.readingMinutes}분 읽기</span></div>
  <h2>{post.data.title}</h2>
  <p>{post.data.description}</p>
</a>
