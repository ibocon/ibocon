---
import { alternatePath, type Locale } from '../lib/locale';
import { siteCopy } from '../lib/site-copy';

interface Props { locale?: Locale; }
const { locale = 'ko' } = Astro.props;
const copy = siteCopy[locale];
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {new Date().getFullYear()} {copy.ownerName}. {copy.footerNotice}</p>
    <nav aria-label={copy.footerLabel}>
      <a href={alternatePath(locale, 'about')}>{copy.aboutLabel}</a>
      <a href={alternatePath(locale, 'resume')}>{copy.resumeLabel}</a>
      <a href={alternatePath(locale, 'editorial')}>{copy.editorialLabel}</a>
      <a href="https://github.com/ibocon" target="_blank" rel="noopener noreferrer">{copy.githubLabel}</a>
    </nav>
  </div>
</footer>
