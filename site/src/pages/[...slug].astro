---
import { getCollection, render } from 'astro:content';
import Analytics from '../components/Analytics.astro';
import AdSenseSlot from '../components/AdSenseSlot.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { koSiteCopy } from '../lib/site-copy';
import '../styles/global.css';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const posts = (await getCollection('blog')).filter((post) => includeDrafts || !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | {koSiteCopy.brandName}</title>
    <meta name="description" content={post.data.description} />
    <link rel="canonical" href={new URL(`/${post.id}/`, 'https://blog.botanicsoft.com').toString()} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <Analytics />
  </head>
  <body>
    <Header locale="ko" page="home" />
    <main class="container post-layout">
      <article class="prose" aria-labelledby="post-title">
        <header class="post-header">
          {post.data.draft && <p class="draft-review-banner" role="status">로컬 검토용 초안 · 공개 전 검토 중</p>}
          <div class="post-meta">{post.data.tags.slice(0, 3).map((tag) => <span class="badge">{tag}</span>)}</div>
          <h1 id="post-title">{post.data.title}</h1>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          <p class="post-provenance">
            <span>최초 게시: {post.data.pubDate.toISOString().slice(0, 10)}</span>
            {post.data.updatedDate && <span>최종 갱신: {post.data.updatedDate.toISOString().slice(0, 10)}</span>}
          </p>
        </header>
        <Content />
        <AdSenseSlot slotId="blog-post-bottom" />
      </article>
      {headings.length > 0 && <nav class="toc" aria-label="Table of Contents"><strong>목차</strong><ul>{headings.map((heading) => <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
    </main>
    <Footer locale="ko" />
    <script>
      const mermaidBlocks = document.querySelectorAll('pre:has(code.language-mermaid)');
      if (mermaidBlocks.length > 0) {
        mermaidBlocks.forEach((block) => {
          const definition = block.textContent?.trim();
          if (definition) {
            block.textContent = definition;
            block.classList.add('mermaid');
          }
        });
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        mermaid.initialize({ startOnLoad: false, theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default' });
        await mermaid.run({ nodes: mermaidBlocks });
      }
    </script>
  </body>
</html>
