---
import { getCollection, render } from 'astro:content';
import Analytics from '../components/Analytics.astro';
import Favicon from '../components/Favicon.astro';
import AdSenseSlot from '../components/AdSenseSlot.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { koSiteCopy } from '../lib/site-copy';
import { getPostPresentation } from '../lib/post-presentation';
import { getTocHeadings } from '../lib/toc';
import '../styles/global.css';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const posts = (await getCollection('blog')).filter((post) => includeDrafts || !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const presentation = getPostPresentation(post.data, post.body ?? '');
const tocHeadings = getTocHeadings(headings);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | {koSiteCopy.brandName}</title>
    <meta name="description" content={post.data.description} />
    <link rel="canonical" href={new URL(`/${post.id}/`, 'https://blog.botanicsoft.com').toString()} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <Favicon />
    <Analytics />
  </head>
  <body>
    <Header locale="ko" page="home" />
    <main class="container post-layout">
      <article class="prose" aria-labelledby="post-title">
        <header class="post-header">
          {post.data.draft && <p class="draft-review-banner" role="status">로컬 검토용 초안 · 공개 전 검토 중</p>}
          <div class="post-meta">{post.data.tags.slice(0, 3).map((tag) => <span class="badge">{tag}</span>)}</div>
          <h1 id="post-title">{post.data.title}</h1>
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          <span class="reading-time">약 {presentation.readingMinutes}분 읽기</span>
          {post.data.updatedDate && (
            <p class="post-provenance">
              <span>최종 갱신: {post.data.updatedDate.toISOString().slice(0, 10)}</span>
            </p>
          )}
          <img class="post-cover" src={presentation.coverImage} alt={`${post.data.title} 대표 이미지`} decoding="async" />
        </header>
        <Content />
        <AdSenseSlot slotId="blog-post-bottom" />
      </article>
      {tocHeadings.length > 0 && <nav class="toc" aria-label="Table of Contents"><strong>목차</strong><ul>{tocHeadings.map((heading) => <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
    </main>
    <Footer locale="ko" />
    <script>
      const mermaidBlocks = [...document.querySelectorAll('pre[data-language="mermaid"]')]
        .map((block) => ({ block, definition: block.textContent?.trim() ?? '' }))
        .filter(({ definition }) => definition.length > 0);
      if (mermaidBlocks.length > 0) {
        mermaidBlocks.forEach(({ block, definition }) => {
          block.textContent = definition;
          block.classList.add('mermaid');
        });
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        const createMermaidThemeVariables = () => {
          const styles = getComputedStyle(document.documentElement);
          const color = (name) => styles.getPropertyValue(name).trim();
          const darkMode = document.documentElement.dataset.theme === 'dark';
          const surface = color('--diagram-surface');
          const text = color('--diagram-text');
          const line = color('--diagram-line');
          return {
            darkMode, background: surface, mainBkg: surface, textColor: text,
            primaryColor: surface, primaryBorderColor: line, primaryTextColor: text,
            secondaryColor: surface, secondaryBorderColor: line, secondaryTextColor: text,
            tertiaryColor: surface, tertiaryBorderColor: line, tertiaryTextColor: text,
            actorBkg: surface, actorBorder: line, actorTextColor: text,
            activationBkgColor: surface, activationBorderColor: line,
            labelBoxBkgColor: surface, labelBoxBorderColor: line, labelTextColor: text,
            lineColor: line, noteBkgColor: surface, noteBorderColor: line, noteTextColor: text,
            signalColor: line, signalTextColor: text, sequenceNumberColor: text,
            fontSize: '17px', fontFamily: 'Pretendard, system-ui, sans-serif'
          };
        };
        const renderMermaid = async () => {
          mermaidBlocks.forEach(({ block, definition }) => {
            block.removeAttribute('data-processed');
            block.textContent = definition;
          });
          mermaid.initialize({
            startOnLoad: false,
            theme: 'base',
            flowchart: { useMaxWidth: false, htmlLabels: true, nodeSpacing: 16, rankSpacing: 48, padding: 12, wrappingWidth: 160 },
            sequence: { actorMargin: 18, diagramMarginX: 8, diagramMarginY: 10, messageMargin: 14, width: 136, actorFontSize: 16, messageFontSize: 16, noteFontSize: 16 },
            themeCSS: `.messageText, .sequenceNumber, .labelText, .loopText, .noteText, text.actor { fill: ${getComputedStyle(document.documentElement).getPropertyValue('--diagram-text').trim()} !important; font-size: 16px !important; }`,
            themeVariables: createMermaidThemeVariables()
          });
          await mermaid.run({ nodes: mermaidBlocks.map(({ block }) => block) });
        };
        await renderMermaid();
        document.addEventListener('site-theme-changed', () => void renderMermaid());
      }
    </script>
  </body>
</html>
