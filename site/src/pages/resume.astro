---
import Analytics from '../components/Analytics.astro';
import Favicon from '../components/Favicon.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { resumeCareer, resumeCompetencies, resumeDomains, resumeEducation, resumeNavigation, resumeProfile, resumeSkillGroups, splitDomainName, splitSkillValues } from '../data/resume';
import { absoluteLocaleUrl } from '../lib/locale';
import { siteCopy } from '../lib/site-copy';
import '../styles/global.css';

const locale = 'ko';
const copy = siteCopy[locale];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{copy.resumeTitle} | {copy.brandName}</title>
    <meta name="description" content={copy.resumeDescription} />
    <link rel="canonical" href={absoluteLocaleUrl(locale, 'resume')} />
    <link rel="alternate" hreflang="ko" href={absoluteLocaleUrl('ko', 'resume')} />
    <link rel="alternate" hreflang="en" href={absoluteLocaleUrl('en', 'resume')} />
    <link rel="alternate" hreflang="x-default" href={absoluteLocaleUrl('ko', 'resume')} />
    <Favicon />
    <Analytics />
  </head>
  <body>
    <Header locale={locale} page="resume" />
    <main class="container resume-page">
      <section id="profile" class="resume-hero">
        <img class="resume-avatar" src="/profile-yegun-kim.png" alt="김예건 프로필 사진" width="96" height="96" decoding="async" />
        <div class="resume-hero-body">
          <h1>{resumeProfile.title}</h1>
          <p class="resume-role">{resumeCareer.role} · {resumeCareer.tenure}</p>
          <p>{resumeProfile.summary}</p>
          <ul class="resume-tags" aria-label="핵심 기술">{resumeProfile.tags.map((tag) => <li>{tag}</li>)}</ul>
        </div>
        <a class="resume-notion-link" href={resumeNavigation.notionMainUrl} target="_blank" rel="noopener noreferrer">Notion에서 전체 이력서 열기</a>
      </section>
      <div class="resume-layout">
        <div class="resume-main">
          <section id="competencies" class="resume-section">
            <h2>대표 역량</h2>
            <ul class="resume-cards resume-cards-2">
              {resumeCompetencies.map(([title, detail]) => <li class="resume-card"><strong>{title}</strong><span>{detail}</span></li>)}
            </ul>
          </section>
          <section id="career" class="resume-section">
            <h2>경력</h2>
            <h3>{resumeCareer.employer} · {resumeCareer.team} · {resumeCareer.role}</h3>
            <p class="resume-meta">{resumeCareer.period} · {resumeCareer.tenure}</p>
            <ol class="resume-timeline">
              {resumeCareer.items.map(([name, summary]) => <li><strong>{name}</strong> <span>— {summary}</span></li>)}
            </ol>
          </section>
          <section id="projects" class="resume-section">
            <h2>주요 프로젝트 바로가기</h2>
            <ul class="resume-cards resume-cards-2">
              {resumeNavigation.projects.map((project) => (
                <li class="resume-card"><a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a><span>{project.summary}</span></li>
              ))}
            </ul>
          </section>
          <section id="domains" class="resume-section">
            <h2>전체 도메인 지도</h2>
            <p>설계에서 구현, 운영, 클라이언트와 하드웨어 연동으로 이어지는 10대 단일 책임 영역입니다.</p>
            <ul class="resume-cards resume-cards-2">
              {resumeNavigation.domains.map((domain, index) => {
                const { number, title } = splitDomainName(domain.name);
                return (
                  <li class="resume-card">
                    <span class="resume-domain-no">{number}</span>
                    <a href={domain.url} target="_blank" rel="noopener noreferrer">{title}</a>
                    <span>{resumeDomains[index][1]}</span>
                  </li>
                );
              })}
            </ul>
          </section>
        </div>
        <aside class="resume-side" aria-label="기술 스택과 학력">
          <section id="skills" class="resume-section">
            <h2>기술 스택</h2>
            <dl>
              {resumeSkillGroups.map(([name, values]) => (
                <>
                  <dt>{name}</dt>
                  <dd><ul class="resume-chips">{splitSkillValues(values).map((value) => <li>{value}</li>)}</ul></dd>
                </>
              ))}
            </dl>
          </section>
          <section id="education" class="resume-section">
            <h2>학력</h2>
            <ul class="resume-education">
              {resumeEducation.map(([period, detail]) => <li><strong>{period}</strong><span>{detail}</span></li>)}
            </ul>
          </section>
        </aside>
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>
