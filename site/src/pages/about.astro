---
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { absoluteLocaleUrl } from '../lib/locale';
import { siteCopy } from '../lib/site-copy';
import '../styles/global.css';

const locale = 'ko';
const copy = siteCopy[locale];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{copy.brandName} {copy.aboutTitle} | BotanicSoft</title>
    <meta name="description" content={`${copy.brandName}의 ${copy.aboutDescription}`} />
    <link rel="canonical" href={absoluteLocaleUrl(locale, 'about')} />
    <link rel="alternate" hreflang="ko" href={absoluteLocaleUrl('ko', 'about')} />
    <link rel="alternate" hreflang="en" href={absoluteLocaleUrl('en', 'about')} />
    <link rel="alternate" hreflang="x-default" href={absoluteLocaleUrl('ko', 'about')} />
    <Analytics />
  </head>
  <body>
    <Header locale={locale} page="about" />
    <main class="container prose static-page">
      <h1>{copy.brandName} 소개</h1>
      <p>{copy.aboutSummary}</p>
      <h2>운영자와 콘텐츠 책임</h2>
      <p>{copy.editorialResponsibility} 기술 선택과 해석은 실무 경험과 공개 문서를 바탕으로 하며, 오류는 정정·갱신 기준에 따라 반영합니다.</p>
      <h2>연락과 정정 제안</h2>
      <p>질문, 정정 제안, 인용 문의는 <a href="https://github.com/ibocon" target="_blank" rel="noopener noreferrer">GitHub 프로필</a>로 남길 수 있으며, 출처·갱신 기준은 <a href="/editorial-policy/">편집 원칙</a>에서 확인할 수 있습니다.</p>
    </main>
    <Footer locale={locale} />
  </body>
</html>
