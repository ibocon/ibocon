{
  "permissions": {
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright__browser_take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/dotnet/guards/Test-PlaywrightArtifactPath.ps1",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/plan/scripts/Invoke-PlanSessionSnapshotOnBash.ps1",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/dotnet/guards/Test-RawDotnetBuildGuard.ps1",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/agents/guards/Test-RecursiveDeleteLinkGuard.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/dotnet/scripts/Invoke-SolutionBuildOnWrite.ps1",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/mermaid/guards/Invoke-MermaidGuardOnWrite.ps1",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/plan/scripts/Invoke-PlanningGuardOnWrite.ps1",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/plan/scripts/Invoke-PlanArchiveOnBash.ps1",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/plan/scripts/Invoke-SessionPlanArchiveSweep.ps1",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/lib/Garden.Harness/src/agents/scripts/Invoke-HookCommand.ps1\" -Target lib/Garden.Harness/src/agents/guards/Test-UserCommandHandoffGuard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
